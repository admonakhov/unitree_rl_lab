  <link name="rear_right_wheel_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0000533" ixy="0.0" ixz="0.0" iyy="0.0000533" iyz="0.0" izz="0.0000533"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="frame_material"/>
    </visual>
  </link>

  <joint name="rear_right_wheel_yaw_joint" type="continuous">
