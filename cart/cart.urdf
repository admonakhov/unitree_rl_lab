      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
          ixx="0.000132"
          ixy="0.0"
          ixz="0.0"
          iyy="0.000125"
          iyz="0.0"
          izz="0.000125"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
