  </link>

  <joint name="front_right_wheel_yaw_joint" type="continuous">
    <parent link="level3_link"/>
    <child link="front_right_wheel_mount"/>
    <origin xyz="0.22 -0.20 -0.065" rpy="0 0 1.57079632679"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="front_right_wheel">
